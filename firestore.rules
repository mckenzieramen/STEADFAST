rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "yahhclffjnd@gmail.com";
    }

    match /quotations/{quoteId} {
      // Public website visitors may submit a quotation without creating an account.
      // Do not allow public users to read, update, or delete quotations.
      allow create: if request.auth == null
        && request.resource.data.source == "steadfast-website"
        && request.resource.data.customerName is string
        && request.resource.data.customerEmail is string
        && request.resource.data.customerEmail.matches("^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$");

      allow read, update, delete: if isAdmin();
    }
  }
}
