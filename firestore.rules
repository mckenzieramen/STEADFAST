rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'yahhclffjnd@gmail.com';
    }

    match /quotations/{quotationId} {
      // Public visitors may submit a quotation, but cannot read quotations.
      // Keep this narrow and validate the important fields.
      allow create: if
        request.resource.data.keys().hasOnly([
          'customerName',
          'customerEmail',
          'phone',
          'company',
          'requirements',
          'preferredNextStep',
          'service',
          'scope',
          'estimate',
          'currency',
          'country',
          'fxRate',
          'rateSource',
          'addons',
          'status',
          'source',
          'createdAt'
        ])
        && request.resource.data.customerName is string
        && request.resource.data.customerName.size() >= 2
        && request.resource.data.customerName.size() <= 120
        && request.resource.data.customerEmail is string
        && request.resource.data.customerEmail.size() >= 5
        && request.resource.data.customerEmail.size() <= 160
        && request.resource.data.service is string
        && request.resource.data.service.size() >= 2
        && request.resource.data.service.size() <= 80
        && request.resource.data.status == 'New'
        && request.resource.data.source == 'steadfast-website'
        && request.resource.data.createdAt is timestamp;

      // Only the authorized STEADFAST admin can read or modify quotation records.
      allow read, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
