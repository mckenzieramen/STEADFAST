rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function admin() {
      return request.auth != null
        && request.auth.token.email == 'yahhclffjnd@gmail.com';
    }

    match /portfolioProjects/{id} {
      allow read: if resource.data.published == true || admin();
      allow create, update, delete: if admin();
    }

    match /storeProducts/{id} {
      allow read: if resource.data.active == true || admin();
      allow create, update, delete: if admin();
    }

    match /storeOrders/{id} {
      allow create: if request.auth != null
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.amount >= 0
        && request.resource.data.customerEmail == request.auth.token.email;
      allow read, update, delete: if admin();
    }

    match /storeCheckout/{id} {
      allow create: if request.auth != null
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.amount >= 0
        && request.resource.data.productName is string;
      allow read: if request.auth != null && resource.data.customerUid == request.auth.uid || admin();
      allow update: if request.auth != null
        && resource.data.customerUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'receiptUrl','receiptFileName','paymentStatus','status','updatedAt'
        ])
        && request.resource.data.status == 'verifying'
        && resource.data.status in ['pending','failed'];
      allow update: if admin();
      allow delete: if admin();
    }

    // Paid purchase grants. A customer can only read grants belonging to their UID.
    match /customerAccess/{id} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid || admin();
      allow create, update, delete: if admin();
    }

    // Public published reviews; only verified buyers can create one review per product.
    match /productReviews/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.published == true
        && request.resource.data.productId is string
        && exists(/databases/$(database)/documents/customerAccess/$(request.auth.uid + '_' + request.resource.data.productId))
        && get(/databases/$(database)/documents/customerAccess/$(request.auth.uid + '_' + request.resource.data.productId)).data.status == 'paid';
      allow update, delete: if admin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
