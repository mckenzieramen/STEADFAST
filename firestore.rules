rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function admin() {
      return request.auth != null
        && request.auth.token.email == 'yahhclffjnd@gmail.com';
    }

    match /portfolioProjects/{id} {
      allow read: if resource.data.published == true || admin();
      allow create, update, delete: if admin();
    }

    match /storeProducts/{id} {
      allow read: if resource.data.active == true || admin();
      allow create, update, delete: if admin();
    }

    // Private order record: customer creates it, only admin can read/change it.
    // This keeps customer email/access credentials out of the public checkout doc.
    match /storeOrders/{id} {
      allow create: if request.resource.data.status == 'pending'
        && request.resource.data.amount >= 0
        && request.resource.data.customerEmail is string;
      allow read, update, delete: if admin();
    }

    // Public checkout session: contains only checkout/payment state, no email or credentials.
    // The document ID is the unguessable order ID used in the checkout URL.
    match /storeCheckout/{id} {
      allow create: if request.resource.data.status == 'pending'
        && request.resource.data.amount >= 0
        && request.resource.data.productName is string;
      allow read: if true;
      allow update: if
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'receiptUrl','receiptFileName','paymentStatus','status','updatedAt'
        ])
        && request.resource.data.status == 'verifying'
        && resource.data.status in ['pending','failed'];
      allow delete: if admin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
