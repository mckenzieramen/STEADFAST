rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function admin() {
      return request.auth != null
        && request.auth.token.email == 'yahhclffjnd@gmail.com';
    }

    match /portfolio/{allPaths=**} {
      allow read: if true;
      allow write: if admin();
    }

    match /store/receipts/{orderId}/{fileName} {
      allow read: if admin();
      allow write: if request.resource.size < 5 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf')
        && firestore.get(/databases/(default)/documents/storeCheckout/$(orderId)).data.status in ['pending','failed'];
    }

    match /store/{allPaths=**} {
      allow read: if true;
      allow write: if admin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
